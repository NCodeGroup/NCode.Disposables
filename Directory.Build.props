<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Shared settings from the project template; this file's own settings, after the import, override them. -->
  <Import Project="$(MSBuildThisFileDirectory)build/ProjectTemplate.props" />

  <!-- A project's own package metadata, such as its Description and PackageTags, is in a project.props beside its project file. -->
  <Import Project="$(MSBuildProjectDirectory)/project.props" Condition="Exists('$(MSBuildProjectDirectory)/project.props')" />

</Project>
