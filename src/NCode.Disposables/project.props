<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Description>Building blocks for IDisposable and IAsyncDisposable in .NET: run an action on dispose, dispose many resources in reverse order, swap the resource an aggregate holds, share a resource through reference-counted leases, and dispose on a synchronization context.</Description>
    <PackageTags>disposable;idisposable;iasyncdisposable;dispose;async;resource-management;reference-counting;shared-reference;dispose-pattern;cleanup;using;memory-management;lifecycle;dotnet</PackageTags>
  </PropertyGroup>
</Project>
