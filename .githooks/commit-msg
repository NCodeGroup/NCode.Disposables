#!/usr/bin/env sh
#
# commit-msg - strip AI agent attribution from the commit message.
#
# A commit records the people who wrote it. Agents add their own attribution:
# Copilot a `Co-authored-by: Copilot <...>` trailer, Claude Code a
# `Co-Authored-By: Claude <noreply@anthropic.com>` trailer, a `Claude-Session:`
# trailer or a "Generated with Claude Code" line. The repository host counts a
# co-author trailer as a contributor, and only rewriting published history
# removes it again. Claude Code's `attribution` setting and VS Code's
# `git.addAICoAuthor` setting already turn these off; this hook removes any
# that slip through, whichever tool wrote the commit.
# It needs grep, and refuses every commit when grep is missing, since it can't
# tell then whether the message has agent attribution.
#
# This file comes from the project template, and template updates replace it.
# Git runs it once it is enabled in a clone; New-Project.ps1 and
# Update-Project.ps1 do that:
#     git config core.hooksPath .githooks
# A clone that uses pre-commit runs it as a local hook instead, with
# `entry: .githooks/commit-msg`, `language: script` and
# `stages: [commit-msg]`; Update-Project.ps1 prints the hook to add.
# env finds sh on PATH: pre-commit on Windows takes a shebang's path
# literally, and Windows has no /bin/sh.

set -eu

msg_file="$1"

copilot='^[[:space:]]*co-authored-by:[[:space:]]*(github[[:space:]]+)?copilot(-swe-agent)?(\[bot\])?[[:space:]]*<'
agent_email='^[[:space:]]*co-authored-by:.*<[^>]*(noreply@anthropic\.com|copilot@users\.noreply\.github\.com)>'
claude_session='^[[:space:]]*claude-session:'
# The C locale reads each byte as a character, so the emoji before the phrase matches [^[:alnum:]] whatever locale the user has; a UTF-8 locale reads it differently on some platforms.
generated='^[^[:alnum:]]*generated with \[?claude code'

status=0
LC_ALL=C grep -qiE -e "$copilot" -e "$agent_email" -e "$claude_session" -e "$generated" "$msg_file" || status=$?
case $status in
    0) ;;
    1) exit 0 ;;
    *)
        echo "commit-msg: can't check the commit message for AI agent attribution, because grep is missing or failed. Put grep on PATH and commit again." >&2
        exit 1
        ;;
esac

# `git stripspace` collapses the blank lines a removed trailer leaves behind,
# as git's own message cleanup does; comment lines stay for the editor flow.
stripped="$msg_file.no-agent-attribution"
LC_ALL=C grep -viE -e "$copilot" -e "$agent_email" -e "$claude_session" -e "$generated" "$msg_file" | git stripspace >"$stripped"
mv "$stripped" "$msg_file"

echo "commit-msg: removed AI agent attribution from the commit message." >&2
